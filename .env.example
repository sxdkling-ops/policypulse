# Tavily key from app.tavily.com
TAVILY_API_KEY=tvly-xxxxxxxx
# Provider keys. Only Bifrost reads these (docker compose or run_bifrost.py pass them in).
CLAUDE_API=sk-ant-xxxxxxxx
GROQ_API=gsk_xxxxxxxx
# Bifrost gateway (OpenAI-compatible) for running the Python app outside Docker.
BIFROST_URL=http://localhost:8080/v1
# Folder holding the knowledge-base PDFs. If missing, data/sample/ is used.
KB_PATH=C:\path\to\HC DATA
# Optional: host ports for docker compose (defaults 8080, 8000, 8501)
# BIFROST_HOST_PORT=8080
# API_HOST_PORT=8000
# APP_HOST_PORT=8501
# Optional
# PRIMARY_MODEL=anthropic/claude-haiku-5-5
# FALLBACK_MODEL=groq/openai/gpt-oss-120b
# KB_FOLDERS=Laws-and-Frameworks/4-Topic-Guides;Laws-and-Frameworks/1-Philippines
